{
  "name": "teacss-vs-tailwindcss",
  "version": "0.0.0",
  "private": true,
  "description": "A reproducible performance comparison of the TeaCSS TypeScript engine, the TeaCSS Rust engine and Tailwind CSS v4.",
  "license": "MIT",
  "author": "Billgo <hi@billgo.me>",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "bench": "node apps/bench/src/main.ts run",
    "bench:corpus": "node apps/bench/src/main.ts corpus",
    "bench:link": "node scripts/link-local.ts",
    "bench:report": "node apps/bench/src/main.ts report",
    "bench:ts-tailwind": "node apps/bench/src/main.ts run --subjects vite-baseline,teacss-ts,tailwind-v4",
    "bench:verify": "node apps/bench/src/main.ts verify",
    "check": "bun run lint:check && bun run typecheck && bun run test && bun run check:layout && bun run check:dependencies",
    "check:dependencies": "node scripts/check-dependencies.ts",
    "check:layout": "node scripts/check-layout.ts",
    "lint": "biome check --write .",
    "lint:check": "biome ci .",
    "test": "node --test \"scripts/**/*.test.ts\" \"apps/**/*.test.ts\" \"packages/**/*.test.ts\"",
    "typecheck": "node scripts/typecheck.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@devjskit/biome-config": "0.3.2",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
