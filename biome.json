{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@devjskit/biome-config"],
  "overrides": [
    {
      "includes": ["packages/subject-teacss/src/engine-entry.css"],
      "linter": { "rules": { "suspicious": { "noUnknownAtRules": "off" } } }
    },
    {
      "includes": ["packages/benchmark/src/features/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@bench/subject-*", "@bench/subject-*/**"],
                    "message": "A feature sees the SubjectClient interface from @bench/infrastructure; only the composition root (appshell) picks an implementation."
                  },
                  {
                    "group": ["**/appshell", "**/appshell/**"],
                    "message": "A feature never imports the composition root."
                  },
                  {
                    "group": ["../*", "../*/**", "!../../**"],
                    "message": "A feature never imports another feature; shared domain code lives beside the features (corpus, css, contract, persistence)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
